{
  "name": "synapse-browser",
  "productName": "Synapse Browser",
  "version": "1.0.1",
  "description": "AI-powered desktop browser agent. Tell your browser what to do; Synapse operates the current website, verifies progress, and asks before consequential actions.",
  "author": "Rahul S R",
  "license": "MIT",
  "type": "module",
  "main": "out/main/background.cjs",
  "homepage": "https://github.com/Rahulrachu/synapse-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rahulrachu/synapse-browser.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "release:win": "npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "lucide-react": "^1.54.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.1.12",
    "zustand": "^5.0.8"
  },
  "build": {
    "appId": "com.synapse.browser",
    "productName": "Synapse Browser",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Synapse-Browser-${version}-Windows-${arch}-Setup.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Synapse Browser"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Rahulrachu",
        "repo": "synapse-browser"
      }
    ]
  }
}
